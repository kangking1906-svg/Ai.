# =========================
# DISCORD
# =========================

DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
GUILD_ID=YOUR_DISCORD_SERVER_ID
BOT_OWNER_ID=YOUR_DISCORD_USER_ID


# =========================
# SERVER
# =========================

PORT=8080
DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=info

AUTO_REGISTER_COMMANDS=true
DASHBOARD_ENABLED=true
STATUS_TEXT=AI Music Assistant


# =========================
# AI
# =========================

AI_PROVIDER=gemini
AI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=YOUR_GEMINI_MODEL_ID

AI_CONTEXT_MESSAGES=12
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_USER_COOLDOWN_MS=5000


# =========================
# TTS
# =========================

TTS_PROVIDER=edge
TTS_API_KEY=
TTS_DEFAULT_VOICE=en-US-AndrewMultilingualNeural
TTS_MAX_CHARS=1000
TTS_USER_COOLDOWN_MS=3000


# =========================
# LAVALINK
# =========================

LAVALINK_HOST=YOUR_LAVALINK_HOST
LAVALINK_PORT=2333
LAVALINK_PASSWORD=YOUR_LAVALINK_PASSWORD
LAVALINK_SECURE=false
LAVALINK_NAME=main


# =========================
# MUSIC
# =========================

MUSIC_DEFAULT_SOURCE=ytsearch
MUSIC_VOLUME=100
MUSIC_LEAVE_TIMEOUT=300000
