NODE_ENV=production

PORT=8080

DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

CLIENT_ID=YOUR_DISCORD_APPLICATION_ID

GUILD_ID=YOUR_SERVER_ID

BOT_OWNER_ID=YOUR_DISCORD_USER_ID

DATABASE_PATH=./data/bot.sqlite

LOG_LEVEL=info

COMMAND_PREFIX=!

CUSTOM_BOT_ROLE_ID=

AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.7
AI_CONTEXT_MESSAGES=8
AI_USER_COOLDOWN_MS=8000
AI_GUILD_ENABLED=true

TTS_PROVIDER=edge
TTS_API_KEY=
TTS_DEFAULT_VOICE=en-US-AndrewMultilingualNeural
TTS_MAX_CHARS=1200
TTS_USER_COOLDOWN_MS=4000

DASHBOARD_ENABLED=true
DASHBOARD_PUBLIC=true

MAX_MESSAGE_LENGTH=2000
MAX_BULK_DELETE=100

AI_ALLOW_MASS_MENTIONS=false

AUTO_REGISTER_COMMANDS=true

STATUS_TEXT=Use /help | All-in-one AI Bot

LAVALINK_HOST=YOUR_LAVALINK_HOST
LAVALINK_PORT=443
LAVALINK_PASSWORD=YOUR_LAVALINK_PASSWORD
LAVALINK_NODE_ID=main
LAVALINK_SECURE=true
LAVALINK_SEARCH_PLATFORM=ytsearch
