# ====================================
# Discord Bot Configuration (.env)
# ====================================

# REQUIRED: Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# REQUIRED: Your Discord Application Client ID
# Get from: https://discord.com/developers/applications
CLIENT_ID=your_client_id_here

# REQUIRED: Your Discord User ID (for owner commands)
# Use: !whoami in Discord or right-click user > Copy User ID
BOT_OWNER_ID=your_user_id_here

# ====================================
# Server Configuration
# ====================================

# Server port (default: 8080)
PORT=8080

# Guild ID for faster command registration (optional, leave empty for global)
# Useful during development
GUILD_ID=

# Bot command prefix for text commands (default: !)
COMMAND_PREFIX=!

# Custom role ID for special permissions (optional)
CUSTOM_BOT_ROLE_ID=

# Bot status text displayed on profile
STATUS_TEXT=✨ /help | All-in-One AI Bot

# ====================================
# Logging Configuration
# ====================================

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# ====================================
# Database Configuration
# ====================================

# Path to SQLite database file
# Default: ./data/bot.sqlite (created automatically)
DATABASE_PATH=./data/bot.sqlite

# ====================================
# AI Configuration (Optional)
# ====================================

# AI Provider: groq, gemini, openrouter, or none (default: none)
# - groq: Free tier available, recommended (https://console.groq.com)
# - gemini: Google's AI (https://aistudio.google.com)
# - openrouter: Multiple models (https://openrouter.ai)
# - none: Disable AI features
AI_PROVIDER=none

# AI API Key (required if AI_PROVIDER is not 'none')
AI_API_KEY=

# AI Model name (depends on provider)
# For Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768
# For Gemini: gemini-pro
# For OpenRouter: see their model list
AI_MODEL=llama-3.3-70b-versatile

# Custom base URL for AI provider (optional, for self-hosted)
AI_BASE_URL=

# Maximum tokens for AI responses (default: 2000)
AI_MAX_TOKENS=2000

# AI temperature (0-1, lower = more precise, higher = more creative)
# Default: 0.7
AI_TEMPERATURE=0.7

# Number of previous messages to include in AI context (default: 10)
AI_CONTEXT_MESSAGES=10

# Cooldown between AI requests per user (milliseconds, default: 3000)
AI_USER_COOLDOWN_MS=3000

# Custom system prompt for AI (optional)
AI_SYSTEM_PROMPT=You are a helpful Discord bot assistant. Be friendly, concise, and helpful.

# Enable/disable AI in guilds (default: true)
AI_GUILD_ENABLED=true

# Allow AI to respond to mass mentions (default: false, for safety)
AI_ALLOW_MASS_MENTIONS=false

# ====================================
# Text-to-Speech (TTS) Configuration
# ====================================

# TTS Provider: edge, elevenlabs, or none (default: edge)
# - edge: Microsoft Edge TTS, free and high quality (recommended)
# - elevenlabs: Premium TTS service (https://elevenlabs.io)
# - none: Disable TTS features
TTS_PROVIDER=edge

# TTS API Key (required only for elevenlabs)
TTS_API_KEY=

# Default voice for TTS
# For Edge: en-US-AriaNeural, en-US-GuyNeural, en-US-JennyNeural
# For ElevenLabs: see their voice list
TTS_DEFAULT_VOICE=en-US-AriaNeural

# Maximum characters per TTS request (default: 2000)
TTS_MAX_CHARS=2000

# Cooldown between TTS requests per user (milliseconds, default: 2000)
TTS_USER_COOLDOWN_MS=2000

# ====================================
# Music Configuration (Lavalink)
# ====================================

# Lavalink server host
LAVALINK_HOST=localhost

# Lavalink server port (default: 2333)
LAVALINK_PORT=2333

# Lavalink server password
LAVALINK_PASSWORD=youshallnotpass

# Lavalink node ID (default: main)
LAVALINK_NODE_ID=main

# Use secure connection (HTTPS/WSS) for Lavalink (default: false)
LAVALINK_SECURE=false

# Search platform for music (ytsearch, scsearch, etc.)
LAVALINK_SEARCH_PLATFORM=ytsearch

# ====================================
# Rate Limiting Configuration
# ====================================

# Maximum commands per window (default: 3)
RATE_LIMIT_COMMANDS=3

# Command rate limit window in milliseconds (default: 5000)
RATE_LIMIT_WINDOW=5000

# Maximum AI requests per window (default: 2)
RATE_LIMIT_AI=2

# AI rate limit window in milliseconds (default: 10000)
RATE_LIMIT_AI_WINDOW=10000

# ====================================
# Feature Toggles
# ====================================

# Enable/disable AI features (default: true)
FEATURE_AI=true

# Enable/disable music features (default: true)
FEATURE_MUSIC=true

# Enable/disable TTS features (default: true)
FEATURE_TTS=true

# Enable/disable moderation features (default: true)
FEATURE_MODERATION=true

# Enable/disable economy system (default: true)
FEATURE_ECONOMY=true

# Enable/disable leveling system (default: true)
FEATURE_LEVELS=true

# Enable/disable ticket system (default: true)
FEATURE_TICKETS=true

# Enable/disable giveaway system (default: true)
FEATURE_GIVEAWAYS=true

# ====================================
# Dashboard Configuration
# ====================================

# Enable web dashboard (default: true)
DASHBOARD_ENABLED=true

# Make dashboard publicly accessible (default: true)
DASHBOARD_PUBLIC=true

# ====================================
# Message Configuration
# ====================================

# Maximum message length (default: 2000)
MAX_MESSAGE_LENGTH=2000

# Maximum bulk delete count (default: 100, max: 100)
MAX_BULK_DELETE=100

# ====================================
# Command Registration
# ====================================

# Automatically register slash commands on startup (default: true)
AUTO_REGISTER_COMMANDS=true

# ====================================
# Notes
# ====================================
# - All values are case-sensitive
# - Remove values to use defaults
# - Do NOT share this file or commit it to git
# - Keep your tokens and API keys secret!
# - For production, use environment variables instead
