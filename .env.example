NODE_ENV=production
PORT=10000
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
BOT_OWNER_ID=

DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=info
COMMAND_PREFIX=!
CUSTOM_BOT_ROLE_ID=

# AI: groq | gemini | openrouter | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.7
AI_CONTEXT_MESSAGES=8
AI_USER_COOLDOWN_MS=8000
AI_GUILD_ENABLED=true

# TTS: edge | none
TTS_PROVIDER=edge
TTS_API_KEY=
TTS_DEFAULT_VOICE=en-US-AndrewMultilingualNeural
TTS_MAX_CHARS=1200
TTS_USER_COOLDOWN_MS=4000

# Web dashboard
DASHBOARD_ENABLED=true
DASHBOARD_PUBLIC=true

# Limits / safety
MAX_MESSAGE_LENGTH=2000
MAX_BULK_DELETE=100
AI_ALLOW_MASS_MENTIONS=false

# Optional bot behavior
AUTO_REGISTER_COMMANDS=true
STATUS_TEXT=Use /help | All-in-one AI Bot
